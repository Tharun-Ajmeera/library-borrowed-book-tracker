{
  "name": "library-borrowed-book-tracker",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Library Borrowed Book Tracker - React, Express, Supabase PostgreSQL, Zod, Tailwind CSS",
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "npm --prefix server run dev",
    "dev:client": "npm --prefix client run dev",
    "install:all": "npm install && npm --prefix server install && npm --prefix client install",
    "build:client": "npm --prefix client run build",
    "build": "npm --prefix client run build",
    "start:server": "npm --prefix server start"
  },
  "workspaces": [
    "client",
    "server"
  ],
  "dependencies": {
    "@supabase/supabase-js": "^2.49.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "morgan": "^1.10.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}

